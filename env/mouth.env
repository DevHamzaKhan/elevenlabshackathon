# MOUTH (Wajeeh). Copy this file to .env at the root of your clone, then fill in the copy.
# Never put real values in this file: it is committed to git. The copy is not.
# Never share the filled-in copy in a group chat.

# From elevenlabs.io > profile menu > API Keys. The plan must allow voice cloning.
ELEVENLABS_API_KEY=

# From the Twilio Console home page, under Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The phone owner's own mobile, verified in Twilio as a caller ID. Example: +14155550100
OWNER_NUMBER=

# The teammate who agreed to take one test call. Example: +14155550123
CALL_ALLOWLIST=

# Leave at 1. It makes every call a fake one until you choose to place a real call.
CALLER_DRY_RUN=1

# v2 (OpenAI). The same OPENAI_API_KEY the Mind uses (platform.openai.com > API keys).
OPENAI_API_KEY=
# Voice front end: openai (default) or elevenlabs. Model/voice ids are optional overrides.
MOUTH_VOICE_VENDOR=
MOUTH_VOICE_MODEL=
MOUTH_VOICE=
MOUTH_TRANSCRIBE_MODEL=
# Phone calls: openai (default, GPT-Live over a SIP trunk) or elevenlabs (the old caller).
CALLER_VENDOR=
CALLER_MODEL=
CALLER_VOICE=
CALLER_SUMMARY_MODEL=
# Twilio Elastic SIP Trunk termination (see mouth/README.md "Caller on OpenAI"). Example: sips:bobby.pstn.twilio.com:5061
CALLER_SIP_URL=
CALLER_SIP_USERNAME=
CALLER_SIP_PASSWORD=
