# MIND (James C). Copy this file to .env at the root of your clone, then fill in the copy.
# Never put real values in this file: it is committed to git. The copy is not.
# Never share the filled-in copy in a group chat.

# From the Claude Console (platform.claude.com) > API keys. The account needs billing.
ANTHROPIC_API_KEY=

# The people Bobby may call, as Name=+number, separated by commas.
# Example: CONTACTS=Alex=+14155550123
CONTACTS=

# OpenAI (the Mind's models). From platform.openai.com > API keys. Replaces ANTHROPIC_API_KEY.
OPENAI_API_KEY=
# Optional model ids and reasoning efforts per role (defaults in mind/README.md).
MIND_ROUTER_MODEL=
MIND_EXEC_MODEL=
MIND_ESCALATE_MODEL=
MIND_ROUTER_EFFORT=
MIND_EXEC_EFFORT=
MIND_ESCALATE_EFFORT=
# Confirm irreversible steps (send, call, pay, delete, post): always | unknown_contacts | never.
MIND_CONFIRM=
