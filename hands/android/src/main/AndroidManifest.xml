<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- `open` with SET_ALARM / SET_TIMER: the clock app only accepts them from holders (normal permission). -->
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

  <!--
    `launch` finds apps by label, so it needs to see launcher activities. `caps` reads the
    default launcher (HOME). The rest let `open` see which app will handle common intents
    (startActivity works without them; they only make the reply's `app` exact sooner).
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="sms" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="smsto" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DIAL" />
      <data android:scheme="tel" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="http" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="geo" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="google.navigation" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SET_ALARM" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SET_TIMER" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SHOW_ALARMS" />
    </intent>
    <intent>
      <action android:name="android.intent.action.INSERT" />
      <data android:mimeType="vnd.android.cursor.dir/event" />
    </intent>
    <intent>
      <action android:name="android.intent.action.WEB_SEARCH" />
    </intent>
  </queries>

  <application>
    <service
      android:name="dev.bobby.hands.HandsService"
      android:exported="true"
      android:label="@string/bobby_hands_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/bobby_hands_accessibility" />
    </service>

    <service
      android:name="dev.bobby.hands.HandsNotificationListener"
      android:exported="true"
      android:label="@string/bobby_hands_notifications_label"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Holding the side button (with this app as the digital assistant) wakes Bobby. -->
    <activity
      android:name="dev.bobby.hands.AssistActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity="dev.bobby.hands.assist"
      android:launchMode="singleInstance"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.ASSIST" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>

    <!-- Turns the screen on and dismisses a Swipe lock screen before an action. -->
    <activity
      android:name="dev.bobby.hands.WakeActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity="dev.bobby.hands.wake"
      android:launchMode="singleInstance"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Shows the PIN keypad (requestDismissKeyguard) and stays up while Hands types the PIN. -->
    <activity
      android:name="dev.bobby.hands.BouncerActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity="dev.bobby.hands.bouncer"
      android:launchMode="singleInstance"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!--
      Bobby's unlock setup: PIN, phrase and earbuds. Native (not React) so the PIN never
      passes through JavaScript; FLAG_SECURE is set in code. Not exported: only the app opens it.
    -->
    <activity
      android:name="dev.bobby.hands.UnlockSetupActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:label="Bobby unlock"
      android:theme="@android:style/Theme.Material.Light.NoActionBar" />

    <!-- Keeps the app's JavaScript alive while other apps are on screen (startKeepAlive). -->
    <service
      android:name="dev.bobby.hands.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="microphone|dataSync" />
  </application>
</manifest>
